{
  "name": "jiankalka-server",
  "version": "1.0.0",
  "description": "考研学习记录 API 服务",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:import-vocab": "node scripts/import-vocab.js",
    "db:import-vocab:kaoyan": "node scripts/download-import-kaoyan.js",
    "db:import-phrases": "node scripts/import-phrases.js",
    "admin:reset-password": "node src/db/reset-admin.js",
    "db:reset": "node src/db/migrate.js && node src/db/seed.js",
    "build:admin": "npm run build --prefix admin-web",
    "job:email-reminder": "node src/jobs/send-email-reminders.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "mysql2": "^3.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "xlsx": "^0.18.5"
  }
}
