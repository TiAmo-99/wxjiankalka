# 服务
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MySQL（宝塔 → 数据库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wxjiankalka
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=wxjiankalka

# 微信小程序（生产必填）
WX_APPID=
WX_SECRET=

# 微信公众号（服务号，用于定时学习提醒，可选）
# 须与小程序绑定同一微信开放平台以使用 unionid
WX_MP_APPID=
WX_MP_SECRET=

# 服务号模板消息 ID（早9 / 下午2 / 晚9，在公众平台复制）
WX_TMPL_MORNING=
WX_TMPL_AFTERNOON=
WX_TMPL_EVENING=

# 小程序订阅消息模板 ID（可选，作为未关注公众号时的补充）
WX_MINI_TMPL_MORNING=
WX_MINI_TMPL_AFTERNOON=
WX_MINI_TMPL_EVENING=

# 邮件提醒（SMTP）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=考研学习记录 <noreply@example.com>

# 学员提交权限申请时通知（默认 jiankalka@qq.com）
PERM_NOTIFY_EMAIL=jiankalka@qq.com
# 邮件中的管理后台链接（静态页部署在 www，非 server 域名）
ADMIN_BASE_URL=https://www.jiankalka.cn/manage

ALLOW_SELF_REGISTER=true

DEV_OPENID=dev_openid_demo

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
